    "Fang": {
      "text": "\u5174\u5e86\u574a\u4f4d\u4e8e\u5916\u90ed\u57ce\u4e1c\u90e8\uff0c\u683c\u7f51\u5750\u6807\u4e3a\uff085,0\uff09\u3002\u5b83\u5317\u90bb\u6c38\u5609\u574a\u3001\u5357\u90bb\u9053\u653f\u574a\u3001\u897f\u90bb\u80dc\u4e1a\u574a\uff0c\u4e1c\u4fa7\u7d27\u9760\u5916\u90ed\u57ce\u4e1c\u57ce\u5899\u3002\u4e94\u738b\u5b85\u540e\u6765\u6269\u5efa\u4e3a\u5174\u5e86\u5bab\uff0c\u4f7f\u8fd9\u91cc\u7531\u666e\u901a\u91cc\u574a\u8f6c\u53d8\u4e3a\u7687\u5bb6\u5bab\u82d1\u7a7a\u95f4\u3002",
      "source": "\u300a\u5510\u4e24\u4eac\u57ce\u574a\u8003\u300b\u5377\u4e8c\u3001\u5377\u4e09"
    },
    "Road": {
      "text": "\u6731\u96c0\u5927\u8857\u4ece\u7687\u57ce\u6731\u96c0\u95e8\u5411\u5357\u76f4\u8fbe\u5916\u90ed\u57ce\u660e\u5fb7\u95e8\uff0c\u662f\u5510\u957f\u5b89\u6700\u91cd\u8981\u7684\u5357\u5317\u4e2d\u8f74\u9053\u8def\u3002\u9053\u8def\u4e24\u4fa7\u6392\u5217\u91cc\u574a\uff0c\u6731\u96c0\u95e8\u8857\u540c\u65f6\u4e5f\u662f\u4e07\u5e74\u53bf\u4e0e\u957f\u5b89\u53bf\u8f96\u533a\u7684\u91cd\u8981\u5206\u754c\u3002",
      "source": "\u300a\u5510\u4e24\u4eac\u57ce\u574a\u8003\u300b\u5377\u4e8c\u53ca\u76f8\u5173\u9053\u8def\u7814\u7a76"
    },
    "Canal": {
      "text": "\u6c38\u5b89\u6e20\u7531\u57ce\u5357\u5165\u57ce\u540e\u5411\u5317\u6d41\uff0c\u7ecf\u5927\u901a\u3001\u6566\u4e49\u3001\u6c38\u5b89\u3001\u5ef6\u798f\u3001\u5d07\u8d24\u3001\u5ef6\u5eb7\u516d\u574a\u897f\u4fa7\uff0c\u7ee7\u7eed\u901a\u5411\u82b3\u6797\u56ed\u3001\u7981\u82d1\u5e76\u6700\u7ec8\u6ce8\u5165\u6e2d\u6c34\u3002",
      "source": "\u300a\u5510\u4e24\u4eac\u57ce\u574a\u8003\u300b\u5377\u56db"
    },
    "Building": {
      "text": "\u5927\u5174\u5584\u5bfa\u4f4d\u4e8e\u9756\u5584\u574a\uff0c\u5e76\u5360\u636e\u6574\u5ea7\u91cc\u574a\u3002\u9756\u5584\u574a\u683c\u7f51\u5750\u6807\u4e3a\uff081,5\uff09\uff0c\u5317\u90bb\u5149\u798f\u574a\u3001\u5357\u90bb\u5170\u9675\u574a\u3001\u4e1c\u90bb\u9756\u5b89\u574a\uff0c\u897f\u4fa7\u9694\u6731\u96c0\u5927\u8857\u4e0e\u5d07\u4e1a\u574a\u76f8\u5bf9\u3002",
      "source": "\u300a\u5510\u4e24\u4eac\u57ce\u574a\u8003\u300b\u5377\u4e8c \u00b7 \u9756\u5584\u574a\u6761"
    }
  }

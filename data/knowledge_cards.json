  "spatial_info": {
    "Gate": {
      "text": "\u6731\u96c0\u95e8\u4f4d\u4e8e\u7687\u57ce\u5357\u9762\u6b63\u4e2d\uff0c\u5317\u5bf9\u627f\u5929\u95e8\uff0c\u5411\u5357\u8fde\u63a5\u6731\u96c0\u5927\u8857\u5e76\u4e0e\u660e\u5fb7\u95e8\u5904\u4e8e\u540c\u4e00\u4e2d\u8f74\u7ebf\u4e0a\u3002",
